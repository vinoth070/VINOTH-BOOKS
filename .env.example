# ==========================================
# VINOTH BOOKS — ENVIRONMENT SPECIFICATION
# ==========================================

# GEMINI_API_KEY: Optional for AI Studio runtime
GEMINI_API_KEY=""

# APP_URL: The URL where this applet/backend is hosted
APP_URL="http://localhost:3000"

# FRONTEND_URL: Allowed CORS origin for production frontend (e.g. GitHub Pages)
FRONTEND_URL="https://vinoth070.github.io"

# VITE_API_BASE_URL: Backend API base URL for the frontend
# When deploying the static frontend to GitHub Pages (https://vinoth070.github.io/VINOTH-BOOKS/),
# point this to your deployed Express backend URL (e.g. https://vinoth-books-api.onrender.com).
# Leave empty for local same-origin development.
VITE_API_BASE_URL=""

# ==========================================
# RAZORPAY PAYMENT GATEWAY
# ==========================================
# Payment Mode: "test" or "live"
RAZORPAY_MODE="test"

# Razorpay Test Mode Credentials
# Dashboard: https://dashboard.razorpay.com/app/keys (Test Mode)
RAZORPAY_TEST_KEY_ID=""
RAZORPAY_TEST_KEY_SECRET=""

# Razorpay Live Mode Credentials (Active when RAZORPAY_MODE=live)
# Dashboard: https://dashboard.razorpay.com/app/keys (Live Mode)
RAZORPAY_LIVE_KEY_ID=""
RAZORPAY_LIVE_KEY_SECRET=""

# Razorpay Webhook Secret (Configured in Razorpay Webhooks tab)
RAZORPAY_WEBHOOK_SECRET=""

# ==========================================
# ADMIN & SYSTEM SECURITY
# ==========================================
ADMIN_EMAIL="kalivinoselvikk@gmail.com"
ADMIN_PASSWORD="admin123"
APP_SECRET="vinoth-books-super-secure-key-2026"

PORT=3000
